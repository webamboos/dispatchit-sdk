{
  "name": "dispatchit",
  "version": "1.0.0",
  "description": "Framework-agnostic SDK for building Dispatchit webhook endpoints.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webamboos/dispatchit-sdk.git",
    "directory": "packages/dispatchit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./adapters/*": {
      "types": "./src/adapters/*.ts",
      "import": "./dist/adapters/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./adapters/*": {
        "types": "./dist/adapters/*.d.ts",
        "import": "./dist/adapters/*.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/express": "catalog:",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "catalog:",
    "hono": "4.13.7",
    "rolldown": "1.2.8",
    "rolldown-plugin-dts": "0.28.5",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
