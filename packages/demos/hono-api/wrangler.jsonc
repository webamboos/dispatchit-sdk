{
  // https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispatchit-hono-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Exposes per-version preview URLs on `wrangler versions upload` (used for PR previews).
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  // Builds the dispatchit SDK (dist/) on fresh clones before wrangler bundles the worker.
  "build": {
    "command": "pnpm --filter dispatchit build",
  },
}
